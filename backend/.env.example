#### Server
PORT=5000
NODE_ENV=development

#### Database (Docker uses service name)
DB_HOST=database
DB_PORT=5432
DB_NAME=saas_db
DB_USER=postgres
DB_PASSWORD=postgres

#### JWT
JWT_SECRET=dev_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=24h

#### Frontend URL (CORS)
FRONTEND_URL=http://frontend:3000
